# -----------------------------------------------
# PharmEasy Frontend - Vercel build-time env template
# Add these variables in the Vercel project settings.
# -----------------------------------------------

# Render backend base API URL (include /api)
VITE_API_URL=https://<your-render-service>.onrender.com/api

# Optional. If omitted, frontend derives socket URL from VITE_API_URL.
VITE_SOCKET_URL=https://<your-render-service>.onrender.com
