# Render backend base API URL (include /api)
VITE_API_URL=https://pharmeasy-backend-k20t.onrender.com/api

# Optional. If omitted, frontend derives socket URL from VITE_API_URL.
VITE_SOCKET_URL=https://pharmeasy-backend-k20t.onrender.com
