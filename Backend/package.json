{
  "name": "pharmeasy-backend",
  "version": "1.0.0",
  "description": "PharmEasy Backend - Node.js + Express + Prisma",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "prisma generate && node src/index.js",
    "dev": "prisma generate && nodemon src/index.js",
    "prod": "prisma generate && NODE_ENV=production node src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "build:frontend": "cd ../Frontend && npm run build",
    "build:all": "npm run build:frontend && echo \"Backend ready for production\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "rest-api"
  ],
  "author": "PharmEasy Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3",
    "tailwindcss": "^4.1.18",
    "uuid": "^9.0.1",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "jest": "^30.3.0",
    "nodemon": "^3.1.11",
    "prisma": "^7.4.2"
  }
}
