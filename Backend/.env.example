# -----------------------------------------------
# PharmEasy Backend - Render + Neon env template
# Copy to .env for local testing, and add these in Render dashboard.
# -----------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=10000

# Neon PostgreSQL connection string (required)
# Use the pooled connection URL from Neon with sslmode=require.
DATABASE_URL=postgresql://<neon_user>:<neon_password>@<neon_host>/<database>?sslmode=require

# JWT secrets (required)
JWT_ACCESS_SECRET=<replace_with_long_random_secret>
JWT_REFRESH_SECRET=<replace_with_long_random_secret>
JWT_RESET_SECRET=<replace_with_long_random_secret>
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d
JWT_RESET_EXPIRY=1h

# Frontend URLs and CORS
FRONTEND_URL=https://<your-vercel-domain>
# Comma-separated exact origins are supported:
CORS_ORIGIN=https://<your-vercel-domain>,https://<your-custom-domain>
# Optional extra comma-separated origins:
CORS_ORIGINS=
# Optional wildcard patterns. Example:
# CORS_ORIGIN_PATTERNS=https://<your-vercel-project>-*.vercel.app
CORS_ORIGIN_PATTERNS=

# Email provider (required EMAIL_USER + EMAIL_PASS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<your-email-account>
EMAIL_PASS=<your-app-password-or-smtp-password>
EMAIL_FROM=PharmEasy <noreply@<your-domain>>

# Cloudinary (required)
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Optional app settings
LOG_LEVEL=info
ENABLE_REFRESH_TOKEN_ROTATION=true
ENABLE_AUDIT_LOGGING=true
