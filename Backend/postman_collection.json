                },
                {
                  "key": "urgencyLevel",
                  "value": "high",
                  "type": "text"
                },
                {
                  "key": "patientName",
                  "value": "John Doe",
                  "type": "text"
                },
                {
                  "key": "contactNumber",
                  "value": "98XXXXXXXX",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "Kathmandu, Nepal",
                  "type": "text"
                },
                {
                  "key": "latitude",
